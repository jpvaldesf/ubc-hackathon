# Copy to .env (never commit .env). Fill in only what your project uses. Testnet/devnet values only.

# Solana (devnet)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=./wallets/devnet-agent.json

# Arc (testnet) — values from docs.arc.io (arc/references/connect-to-arc, contract-addresses), checked 2026-11-14
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://explorer.testnet.arc.io
# USDC ERC-20 interface: 6 decimals. Native gas balance is the SAME USDC at 18 decimals. Contracts use ERC-20 only.
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_USDC_DECIMALS=6
# Min base fee 20 gwei: set maxFeePerGas >= 20 gwei or txs can hang.
# Fresh keys only (cast wallet new). NOT anvil/test-mnemonic keys: index 1 (0x7099…79C8) is blocklisted on Arc testnet.
LANDLORD_PRIVATE_KEY=
TENANT_PRIVATE_KEY=
ARBITER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=

# Circle
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Gemini (sandbox first: https://api.sandbox.gemini.com)
GEMINI_API_KEY=
GEMINI_API_SECRET=
GEMINI_BASE_URL=https://api.sandbox.gemini.com

# QuickNode
QUICKNODE_ENDPOINT=
QUICKNODE_STREAM_WEBHOOK_SECRET=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# LLM for your agent (if your product calls a model)
ANTHROPIC_API_KEY=

# Agent guardrails (enforced in code; document them in the README)
AGENT_MAX_PER_TX_USDC=0.50
AGENT_DAILY_BUDGET_USDC=5.00
AGENT_APPROVAL_THRESHOLD_USDC=1.00
AGENT_RECIPIENT_ALLOWLIST=

# Hosted server only
DK_DEMO_TOKEN=
DK_MAX_LEASES_PER_DAY=20
DK_MAX_REPORTS_PER_DAY=20
DK_MAX_DEPOSIT_CENTS=1000
