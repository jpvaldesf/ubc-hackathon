# Copy to .env (never commit .env). Fill in only what your project uses. Testnet/devnet values only.

# Solana (devnet)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=./wallets/devnet-agent.json

# Arc (testnet)
ARC_RPC_URL=
ARC_CHAIN_ID=
AGENT_PRIVATE_KEY=

# Circle
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Gemini (sandbox first: https://api.sandbox.gemini.com)
GEMINI_API_KEY=
GEMINI_API_SECRET=
GEMINI_BASE_URL=https://api.sandbox.gemini.com

# QuickNode
QUICKNODE_ENDPOINT=
QUICKNODE_STREAM_WEBHOOK_SECRET=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# LLM for your agent (if your product calls a model)
ANTHROPIC_API_KEY=

# Agent guardrails (enforced in code; document them in the README)
AGENT_MAX_PER_TX_USDC=0.50
AGENT_DAILY_BUDGET_USDC=5.00
AGENT_APPROVAL_THRESHOLD_USDC=1.00
AGENT_RECIPIENT_ALLOWLIST=
