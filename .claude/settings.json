{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(pnpm run *)",
      "Bash(pnpm test *)",
      "Bash(bun run *)",
      "Bash(bun test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git worktree *)",
      "Bash(anchor build *)",
      "Bash(anchor test *)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(forge build *)",
      "Bash(forge test *)",
      "Bash(solana balance *)",
      "Bash(solana address *)",
      "Bash(solana confirm *)",
      "Bash(bash .claude/hooks/countdown.sh)",
      "mcp__solana__*",
      "mcp__arc-docs__*",
      "mcp__circle__*",
      "mcp__context7__*",
      "WebFetch(domain:solana.com)",
      "WebFetch(domain:docs.arc.network)",
      "WebFetch(domain:developers.circle.com)",
      "WebFetch(domain:developer.gemini.com)",
      "WebFetch(domain:www.quicknode.com)",
      "WebFetch(domain:elevenlabs.io)",
      "WebFetch(domain:x402.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(anchor deploy *)",
      "Bash(solana program deploy *)",
      "Bash(solana transfer *)",
      "Bash(forge script *)",
      "Bash(forge create *)",
      "Bash(npx hardhat run *)",
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)",
      "Bash(git push --force *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/*keypair*.json)",
      "Read(~/.config/solana/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-context.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-secrets.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-mainnet.sh" }
        ]
      }
    ]
  }
}
